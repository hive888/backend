# Backend API — copy to .env on the server. Do not commit secrets.
# PostgreSQL is required (MySQL is no longer supported).

DB_HOST=hive888-postgres
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=hive888_db
DB_CONNECTION_LIMIT=10
DATABASE_URL=postgresql://USER:PASSWORD@hive888-postgres:5432/hive888_db

PORT=3000
NODE_ENV=production
API_URL=https://api.hive888.org
BACKEND_PUBLIC_URL=https://api.hive888.org
FRONTEND_URL=https://hub.hive888.org
FRONTENDHIVE_URL=https://hub.hive888.org
BASE_URL=https://hub.hive888.org
ALLOWED_ORIGINS=https://hub.hive888.org,https://admin.hive888.org,https://hive888.org,https://www.hive888.org

JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

REDIS_URL=redis://ptgr-redis:6379

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
CLOUDFRONT_URL=https://dimfhxe68q9tj.cloudfront.net

STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET=

CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.co
SUCCESS_CALLBACK_URL=/payment/success
CANCEL_CALLBACK_URL=/payment/cancel

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_LINK=
TELEGRAM_PRIVATE_GROUP_ID=
TELEGRAM_PUBLIC_GROUP_ID=
TELEGRAM_LINK_FRONTEND_URL=https://hub.hive888.org/en/profile
# Keep false on extra processes. Only one instance may poll the production bot.
TELEGRAM_ENABLE_POLLING=false

GEMINI_API_KEY=

# Chatbot (backend/controllers/chatController.js) — required for POST /api/chat to work.
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-opus-5
ANTHROPIC_MODEL=

# Chapa (backend/config/chapaConfig.js) — required for access codes with
# preferred_payment_method='chapa' to work. Also used to verify the
# x-chapa-signature header on POST /api/webhook/chapa-webhook.
CHAPA_SECRET_KEY=
