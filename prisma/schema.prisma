generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccessCodeUsers {
  id Int @id @default(autoincrement())
  access_code_id Int
  first_name String @db.VarChar(100)
  last_name String @db.VarChar(100)
  email String? @db.VarChar(255)
  phone String? @db.VarChar(20)
  status String? @default("pending") @db.VarChar(64)
  registered_at DateTime? @db.Timestamp(0)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  @@unique([access_code_id, first_name, last_name, email])
  @@index([access_code_id])
  @@index([status])
  @@index([first_name, last_name])
  @@index([email])
  @@index([phone])
  @@map("access_code_users")
}

model AccessCodes {
  id Int @id @default(autoincrement())
  code String @unique @db.VarChar(64)
  course_id Int?
  payment_amount Decimal @default(18.00) @db.Decimal(10, 2)
  payment_currency String @default("USD") @db.VarChar(10)
  exit_exam_fee Decimal @default(0.00) @db.Decimal(10, 2)
  preferred_payment_method String @default("stripe") @db.VarChar(20)
  university_id Int?
  label String? @db.VarChar(255)
  university_name String? @db.VarChar(255)
  total_students Int?
  max_uses Int?
  used_count Int @default(0)
  is_active Int @default(1) @db.SmallInt
  expires_at DateTime? @db.Timestamp(0)
  notes String? @db.Text
  created_by String? @db.VarChar(36)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  @@index([course_id])
  @@index([university_id])
  @@map("access_codes")
}

model ActivityLogs {
  id Int @id @default(autoincrement())
  customer_id Int
  related_customer_id Int?
  activity_type String @db.VarChar(100)
  description String? @db.Text
  metadata Json?
  created_at DateTime @default(now()) @db.Timestamp(0)
  @@index([customer_id])
  @@index([related_customer_id])
  @@index([activity_type])
  @@index([created_at])
  @@map("activity_logs")
}

model Addresses {
  address_id String @id @default(dbgenerated("gen_random_uuid()::text")) @db.VarChar(36)
  customer_id Int
  address_type String @db.VarChar(64)
  recipient_name String? @db.VarChar(255)
  address_line1 String @db.VarChar(255)
  address_line2 String? @db.VarChar(255)
  city String @db.VarChar(100)
  state String? @db.VarChar(100)
  postal_code String @db.VarChar(20)
  country String @db.VarChar(100)
  phone String? @db.VarChar(20)
  is_default Int? @default(0) @db.SmallInt
  notes String? @db.Text
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  isShippingTheSame Int? @default(0) @db.SmallInt
  @@index([customer_id])
  @@index([country])
  @@index([address_type, customer_id])
  @@map("addresses")
}

model AssessmentContent {
  skill String @id @db.VarChar(50)
  role_title String @db.VarChar(150)
  questions Json
  project_brief String? @db.Text
  instructions String? @db.Text
  is_active Int @default(1) @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
